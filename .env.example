# Tuỳ chọn: URL form đăng ký ngoài (Google Form, v.v.). Nếu không set, nút "Tham gia" dẫn tới /recruitment.
NEXT_PUBLIC_REGISTER_URL=
NEXT_PUBLIC_FORM_ID=

# Org GitHub chung của CLB (hiển thị trang Dự án).
NEXT_PUBLIC_GITHUB_ORG=https://github.com/techtonicclub

# --- Chatbot TechTonic (server-only) ---
# Gemini API key (không public).
GEMINI_API_KEY=

# Supabase project URL (không public).
SUPABASE_URL=

# Supabase service role key (không public; dùng trong API routes).
SUPABASE_SERVICE_ROLE_KEY=

# (Tuỳ chọn) Embedding model cho Gemini. Mặc định: gemini-embedding-001 và gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite