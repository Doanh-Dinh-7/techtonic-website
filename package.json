{
  "name": "techtonic-website",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run typecheck && npm run format:check && npm run test",
    "ci:build": "npm run ci && npm run build:check",
    "build:check": "node scripts/build-with-log.mjs && node scripts/check-bundle-budget.mjs build-output.log",
    "lighthouse": "node scripts/lighthouse-ci.mjs",
    "lighthouse:local": "node scripts/lighthouse-env-run.mjs local",
    "lighthouse:local:soft": "node scripts/lighthouse-env-run.mjs local soft",
    "lighthouse:audit": "node scripts/run-lighthouse.mjs",
    "lighthouse:audit:local": "node scripts/lighthouse-audit-local.mjs",
    "lighthouse:soft": "node scripts/lighthouse-env-run.mjs soft",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "start": "next start"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,css,mdc}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/is-prop-valid": "latest",
